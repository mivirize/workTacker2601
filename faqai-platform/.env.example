# ─────────────────────────────────────
# Database
# ─────────────────────────────────────
DATABASE_URL=postgresql://faqai:faqai_secret@localhost:5432/faqai_dev
DATABASE_URL_TEST=postgresql://faqai:faqai_secret@localhost:5432/faqai_test

# ─────────────────────────────────────
# Redis
# ─────────────────────────────────────
REDIS_URL=redis://:redis_secret@localhost:6379

# ─────────────────────────────────────
# Storage (MinIO / S3)
# ─────────────────────────────────────
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=minio_secret
MINIO_BUCKET=faqai-assets
MINIO_REGION=us-east-1

# ─────────────────────────────────────
# Auth
# ─────────────────────────────────────
JWT_SECRET=change-this-to-a-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ─────────────────────────────────────
# LLM Providers (z.ai is preferred if ZAI_API_KEY is set)
# ─────────────────────────────────────
ZAI_API_KEY=your-zai-api-key
ZAI_MODEL=glm-5
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_AI_API_KEY=...
DEFAULT_LLM_PROVIDER=zai
LLM_MONTHLY_BUDGET_USD=100

# ─────────────────────────────────────
# App URLs
# ─────────────────────────────────────
API_URL=http://localhost:3001
WS_URL=ws://localhost:3002
DASHBOARD_URL=http://localhost:3000
FAQ_PORTAL_URL=http://localhost:3003
WIDGET_CDN_URL=http://localhost:3004

# ─────────────────────────────────────
# Widget
# ─────────────────────────────────────
WIDGET_ALLOWED_ORIGINS=*

# ─────────────────────────────────────
# Email (Optional)
# ─────────────────────────────────────
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# ─────────────────────────────────────
# Notifications (Optional)
# ─────────────────────────────────────
SLACK_WEBHOOK_URL=

# ─────────────────────────────────────
# Monitoring (Optional)
# ─────────────────────────────────────
SENTRY_DSN=
